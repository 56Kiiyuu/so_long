NAME = libft.a
CC = cc
CFLAGS = -Wall -Wextra -Werror
INC_DIR = ./

SRC_DIR = ./src
LIBFT_SRC = $(SRC_DIR)/ft_isalpha.c \
			$(SRC_DIR)/ft_isdigit.c \
			$(SRC_DIR)/ft_isalnum.c \
			$(SRC_DIR)/ft_isascii.c \
			$(SRC_DIR)/ft_isprint.c \
			$(SRC_DIR)/ft_strlen.c \
			$(SRC_DIR)/ft_memset.c \
			$(SRC_DIR)/ft_toupper.c \
			$(SRC_DIR)/ft_tolower.c \
			$(SRC_DIR)/ft_atoi.c \
			$(SRC_DIR)/ft_strlcpy.c \
			$(SRC_DIR)/ft_strlcat.c \
			$(SRC_DIR)/ft_strdup.c \
			$(SRC_DIR)/ft_strncmp.c \
			$(SRC_DIR)/ft_bzero.c \
			$(SRC_DIR)/ft_strchr.c \
			$(SRC_DIR)/ft_strrchr.c \
			$(SRC_DIR)/ft_strnstr.c \
			$(SRC_DIR)/ft_memcpy.c \
			$(SRC_DIR)/ft_memmove.c \
			$(SRC_DIR)/ft_memchr.c \
			$(SRC_DIR)/ft_memcmp.c \
			$(SRC_DIR)/ft_calloc.c \
			$(SRC_DIR)/ft_strtrim.c \
			$(SRC_DIR)/ft_strjoin.c \
			$(SRC_DIR)/ft_substr.c \
			$(SRC_DIR)/ft_strmapi.c \
			$(SRC_DIR)/ft_striteri.c \
			$(SRC_DIR)/ft_itoa.c \
			$(SRC_DIR)/ft_split.c \
			$(SRC_DIR)/ft_putchar_fd.c \
			$(SRC_DIR)/ft_putstr_fd.c \
			$(SRC_DIR)/ft_putnbr_fd.c \
			$(SRC_DIR)/ft_putendl_fd.c

BONUS_SRC = $(SRC_DIR)/ft_lstadd_back.c \
			$(SRC_DIR)/ft_lstadd_front.c \
			$(SRC_DIR)/ft_lstclear.c \
			$(SRC_DIR)/ft_lstdelone.c \
			$(SRC_DIR)/ft_lstlast.c \
			$(SRC_DIR)/ft_lstnew.c \
			$(SRC_DIR)/ft_lstsize.c \
			$(SRC_DIR)/ft_lstiter.c \
			$(SRC_DIR)/ft_lstmap.c

GNL_DIR = ./GNL
GNL_SRC = $(GNL_DIR)/get_next_line.c \
			$(GNL_DIR)/get_next_line_utils.c

FT_PRINTF_DIR = ./ft_printf
FT_PRINTF_SRC = $(FT_PRINTF_DIR)/ft_printf.c \
			$(FT_PRINTF_DIR)/ft_printchar.c \
			$(FT_PRINTF_DIR)/ft_printhex.c \
			$(FT_PRINTF_DIR)/ft_printnbr.c \
			$(FT_PRINTF_DIR)/ft_printper.c \
			$(FT_PRINTF_DIR)/ft_printptr.c \
			$(FT_PRINTF_DIR)/ft_printstr.c \
			$(FT_PRINTF_DIR)/ft_printuint.c

OBJS		= $(LIBFT_SRC:.c=.o)
OBJS_BONUS	= $(BONUS_SRC:.c=.o)
OBJS_GNL	= $(GNL_SRC:.c=.o)
OBJS_FT_PRINTF = $(FT_PRINTF_SRC:.c=.o)

%.o: %.c
	$(CC) $(CFLAGS) -I $(INC_DIR) -c $< -o $@

all: $(NAME)

$(NAME): $(OBJS) $(OBJS_GNL) $(OBJS_FT_PRINTF)
	ar -rcs $@ $^

bonus: $(NAME)
	ar -rcs $(NAME) $(OBJS_BONUS)

clean:
	rm -f $(OBJS) $(OBJS_BONUS) $(OBJS_GNL) $(OBJS_FT_PRINTF)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all bonus clean fclean re
